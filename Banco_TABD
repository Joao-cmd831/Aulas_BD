-- 1. Function
-- Calcula o valor total de um pedido

DELIMITER $$

create function fn_total_pedido(p_id_pedido INT)
returns decimal(10,2)
reads sql data
begin
    declare v_total decimal(10,2);

    select coalesce(SUM(quantidade * preco_unitario), 0)
    into v_total
    from item_pedido
    where id_pedido = p_id_pedido;

    return v_total;
end $$

DELIMITER ;

select fn_total_pedido(1) as total_pedido;


-- 2. Procedure
-- Recalcula o valor total do pedido

DELIMITER $$

create procedure sp_recalcular_total_pedido(
    in p_id_pedido int
)
begin
    update pedido
    set valor_total = fn_total_pedido(p_id_pedido)
    where id_pedido = p_id_pedido;
end $$

DELIMITER ;

call sp_recalcular_total_pedido(1);

select * from pedido;


-- 3. Procedure
-- Consulta os pedidos de um cliente

DELIMITER $$

create procedure sp_listar_pedidos_cliente(
    in p_id_cliente int
)
begin
    select
        p.id_pedido,
        c.nome as cliente,
        p.data_pedido,
        p.status,
        p.valor_total
    from pedido p
    inner join cliente c
        on p.id_cliente = c.id_cliente
    where p.id_cliente = p_id_cliente
    order by p.data_pedido desc;

end $$

DELIMITER ;

call sp_listar_pedidos_cliente(1);


-- 4. Trigger
-- Verifica se existe estoque suficiente
-- antes de inserir um item no pedido

DELIMITER $$

create trigger trg_verificar_estoque
before insert on item_pedido
for each row
begin
    declare v_estoque int;

    select estoque
    into v_estoque
    from produto
    where id_produto = new.id_produto
    for update;

    if v_estoque < new.quantidade then
        signal sqlstate '45000'
        set message_text = 'Estoque insuficiente para este produto';
    end if;
end $$

DELIMITER ;


-- 5. Trigger
-- Desconta o estoque após inserir um item

DELIMITER $$

create trigger trg_descontar_estoque
after insert on item_pedido
for each row
begin
    update produto
    set estoque = estoque - new.quantidade
    where id_produto = new.id_produto;
end $$

DELIMITER ;


-- 6. Trigger
-- Devolve o estoque quando um item é excluído

DELIMITER $$

create trigger trg_devolver_estoque
after delete on item_pedido
for each row
begin
    update produto
    set estoque = estoque + old.quantidade
    where id_produto = old.id_produto;
end $$

DELIMITER ;

delete from item_pedido
where id_pedido = 1
and id_produto = 3;

select * from produto
where id_produto = 3;
